# Local Supabase: get these values from `supabase status` in this checkout.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Required for administrative features; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Optional translation. Supply your own model credentials AND prompt resources.
# The application uses the same translation logic; secret prompt text is external.
# Default dictionary profile remains luna6, as in the application.
# DICTIONARY_TRANSLATION_PROFILE=luna6
# AZURE_OPENAI_GPT6_LUNA_MODEL=
# AZURE_OPENAI_GPT6_LUNA_ENDPOINT=
# AZURE_OPENAI_GPT6_LUNA_API_KEY_PRIMARY=
TRANSLATION_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=your-compatible-model
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions
# TRANSLATION_PROMPTS_DIR=/absolute/path/to/your/private-prompt-bundle
# Alternatively inject one server-only JSON secret from your secret manager:
# TRANSLATION_PROMPTS_JSON={"openai_translation_system_v1.txt":"your instructions"}

# Optional text-to-speech. Generated audio is not included in the source release.
AUDIO_QUALITY_DEFAULT=free
# GOOGLE_TTS_API_KEY=

APP_ROLLOUT_PROFILE=pilot
PLATFORM_V2_TRANSLATION_EXERCISES_ENABLED=false

# Optional public dictionary labels/catalog settings; never put secrets here.
# NEXT_PUBLIC_DICTIONARY_SOURCE_PROFILE={"displayName":"My dictionary","coreListName":"Starter words"}

# Existing operators can keep installation metadata outside the public checkout.
# DICTIONARY_SOURCE_PROFILE_JSON={"fingerprintVersion":"your-installed-version"}
# Alternatively mount a JSON profile (do not set both server options):
# DICTIONARY_SOURCE_PROFILE_FILE=/absolute/path/to/installation-profile.json
