# Public (inlined into Next.js client bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Translation providers (server-only)
TRANSLATION_PROVIDER=openai
TRANSLATION_FALLBACK=deepl
DEEPL_API_KEY=your-deepl-key

# Generic fragments, article translations, and other non-dictionary OpenAI calls.
# Endpoint is an Azure OpenAI resource base or OpenAI-compatible v1 endpoint.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=your-azure-openai-key
OPENAI_MODEL=gpt-6-luna

# Dictionary meanings: profile selects prompt/settings; these variables select
# its deployment and credentials. Use gpt41 profile for the GPT-4.1 rollback.
DICTIONARY_TRANSLATION_PROFILE=luna6
AZURE_OPENAI_GPT6_LUNA_MODEL=gpt-6-luna
AZURE_OPENAI_GPT6_LUNA_ENDPOINT=https://your-luna-resource.openai.azure.com/openai/v1
AZURE_OPENAI_GPT6_LUNA_API_KEY_PRIMARY=your-luna-key
AZURE_OPENAI_GPT41_MODEL=gpt-4.1
# Optional dedicated GPT-4.1 endpoint/key; otherwise use AZURE_OPENAI_* above.
# AZURE_OPENAI_GPT41_ENDPOINT=https://your-gpt41-resource.openai.azure.com/openai/v1
# AZURE_OPENAI_GPT41_API_KEY_PRIMARY=your-gpt41-key

# Optional alternate providers
# GEMINI_MODEL=your-gemini-model
# GEMINI_API_URL=https://your-gemini-endpoint
# GEMINI_API_KEY=your-gemini-key
# DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# Automated testing (Playwright, browser automation)
# Keep real credentials in `.env.local` (gitignored); never commit them.
QA_TEST_USER_EMAIL=test@2000nl.test
QA_TEST_USER_EMAIL_ALLOWLIST=test@2000nl.test
# Required for production QA: comma-separated primary/reference identities that must never be used.
QA_REFERENCE_USER_EMAILS=owner@example.com
TEST_USER_PASSWORD=test-password-123

# Optional: enables provisioning/seeding via Supabase Admin API scripts (server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dedicated read-only token for external public catalog lookup/search.
# External clients send this to /api/platform/v1/catalog/lookup and
# /api/platform/v1/catalog/search. Do not reuse a shared end-user token here.
PLATFORM_CATALOG_ACCESS_TOKEN=your-random-catalog-token

# UI and Platform rollout profile. The current UI uses the single supported
# profile `pilot`; deployments set it explicitly and local startup supplies it.
APP_ROLLOUT_PROFILE=pilot
# Sentence exercises remain an independent capability gate.
PLATFORM_V2_TRANSLATION_EXERCISES_ENABLED=false
