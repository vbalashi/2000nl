{
  "name": "2000nl-ui",
  "version": "0.16.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/next-build-with-metadata.js",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "audit:practice-styles": "node scripts/audit-practice-styles.mjs",
    "check:practice-styles": "node scripts/audit-practice-styles.mjs --check",
    "test": "vitest run",
    "test:platform": "vitest run tests/api/platform*.test.ts",
    "test:watch": "vitest --watch",
    "eval:translation": "vite-node scripts/eval-translation-prompt.ts",
    "test:e2e": "playwright test --grep-invert @pilot && APP_ROLLOUT_PROFILE=pilot playwright test --grep @pilot",
    "test:e2e:training-attribution": "APP_ROLLOUT_PROFILE=pilot playwright test playwright/tests/training-attribution.spec.ts",
    "test-account": "node scripts/test-account.js",
    "dev:builder-prototype": "NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 NEXT_PUBLIC_SUPABASE_ANON_KEY=prototype-placeholder next dev --hostname 0.0.0.0 --port 3100",
    "test:e2e:training-reliability": "APP_ROLLOUT_PROFILE=pilot playwright test playwright/tests/training-completed-restart.spec.ts playwright/tests/training-idle-continuity.spec.ts playwright/tests/training-startup-continuity.spec.ts playwright/tests/training-overview-layout.spec.ts playwright/tests/training-overview-recipe-state.spec.ts playwright/tests/training-builder-actions-575.spec.ts --workers=1"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^6.4.0",
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "^2.45.0",
    "clsx": "^1.2.1",
    "lucide-react": "^1.31.0",
    "next": "15.5.26",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-joyride": "^3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.0",
    "@radix-ui/themes": "3.1.6",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.9",
    "@types/pg": "^8.16.0",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.54.0",
    "eslint-config-next": "15.5.26",
    "jsdom": "^23.0.0",
    "pg": "^8.11.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vitest": "^1.4.6"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    },
    "sharp": "0.35.5"
  }
}
