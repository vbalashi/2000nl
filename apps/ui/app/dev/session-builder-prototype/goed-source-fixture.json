          "contentNodeId": "004396_a4440_goed_bn_2-d",
          "parentContentNodeId": null,
          "kind": "definition",
          "text": "iets wat goed is, is juist of klopt",
          "children": []
        },
        "entryTranslation": null,
        "entryTranslationAlternatives": [],
        "translationStatus": null,
        "details": [
          {
            "contentNodeId": "004396_a4440_goed_bn_2-e0",
            "parentContentNodeId": null,
            "kind": "example",
            "text": "ze gaf het goede antwoord",
            "children": []
          },
          {
            "contentNodeId": "004396_a4440_goed_bn_2-i0",
            "parentContentNodeId": null,
            "kind": "idiom",
            "text": "alles goed en wel, maar …",
            "children": [
              {
                "contentNodeId": "004396_a4440_goed_bn_2-ix0",
                "parentContentNodeId": null,
                "kind": "idiom-explanation",
                "text": "dat kan wel zo zijn, maar …",
                "children": []
              }
            ]
          },
          {
            "contentNodeId": "004396_a4440_goed_bn_2-i1",
            "parentContentNodeId": null,
            "kind": "idiom",
            "text": "zo goed als …",
            "children": [
              {
                "contentNodeId": "004396_a4440_goed_bn_2-ix1",
                "parentContentNodeId": null,
                "kind": "idiom-explanation",
                "text": "vrijwel helemaal",
                "children": []
              },
              {
                "contentNodeId": "004396_a4440_goed_bn_2-i1-example0",
                "parentContentNodeId": "004396_a4440_goed_bn_2-i1",
                "kind": "example",
                "text": "die schoenen zijn nog zo goed als nieuw",
                "children": []
              }
