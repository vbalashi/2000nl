              {
                "contentNodeId": "004396_a4440_goed_bn_2-ix2",
                "parentContentNodeId": null,
                "kind": "idiom-explanation",
                "text": "zo goed als in de situatie mogelijk is",
                "children": []
              }
            ]
          }
