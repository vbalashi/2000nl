        "definition": {
          "contentNodeId": "004396_a4440_goed_bn_1-d",
          "parentContentNodeId": null,
          "kind": "definition",
          "text": "iets wat goed is, heeft een hoge kwaliteit",
          "children": []
        },
        "entryTranslation": null,
        "entryTranslationAlternatives": [],
        "translationStatus": null,
        "details": [
          {
            "contentNodeId": "004396_a4440_goed_bn_1-e0",
            "parentContentNodeId": null,
            "kind": "example",
            "text": "Ruud is een goede leraar",
            "children": []
          },
          {
            "contentNodeId": "004396_a4440_goed_bn_1-e1",
            "parentContentNodeId": null,
            "kind": "example",
            "text": "heb je een goede vakantie gehad?",
            "children": []
          },
          {
            "contentNodeId": "004396_a4440_goed_bn_1-i0",
            "parentContentNodeId": null,
            "kind": "idiom",
            "text": "iets valt in goede aarde",
            "children": [
              {
                "contentNodeId": "004396_a4440_goed_bn_1-ix0",
                "parentContentNodeId": null,
                "kind": "idiom-explanation",
                "text": "iets wordt gewaardeerd",
                "children": []
              },
              {
                "contentNodeId": "004396_a4440_goed_bn_1-i0-example0",
                "parentContentNodeId": "004396_a4440_goed_bn_1-i0",
                "kind": "example",
                "text": "het voorstel om wat vroeger naar huis te gaan, viel bij iedereen in goede aarde",
                "children": []
              }
            ]
          },
          {
            "contentNodeId": "004396_a4440_goed_bn_1-i1",
            "parentContentNodeId": null,
            "kind": "idiom",
            "text": "alles goed?",
            "children": [
              {
                "contentNodeId": "004396_a4440_goed_bn_1-ix1",
                "parentContentNodeId": null,
                "kind": "idiom-explanation",
                "text": "dit zeg je als je wilt weten hoe het met iemand gaat",
                "children": []
              }
            ]
          }
        ],
        "schedulerPhase": null,
        "reviewCapabilities": [],
        "repeatCount": 0,
        "startLearning": null,
        "markKnown": null,
        "undoKnown": null,
